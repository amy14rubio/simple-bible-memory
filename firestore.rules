rules_version = '2';

// Public decks: anyone can read them, only the signed-in person who published a deck can change or remove it.
// A person's own backup (users/{uid}/items) is readable and writable by that person only.
// Everything else is closed.
//
// The list of allowed translations below must match src/domain/sharing/translations.ts (a test checks this).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isText(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function isTextOrNull(v, max) { return v == null || (v is string && v.size() <= max); }
    function languageOf(translation) {
      return {
        'KJV': 'en', 'WEB': 'en', 'ASV': 'en', 'YLT': 'en', 'DARBY': 'en', 'RV1909': 'es'
      }.get(translation, null);
    }
    // An open translation must match its own language; "my own words" (OWN) may be either.
    function translationOk(d) {
      return (d.translation == 'OWN' && d.language in ['en', 'es'])
          || (d.translation != 'OWN' && languageOf(d.translation) != null && languageOf(d.translation) == d.language);
    }
    function validDeck(d) {
      return d.keys().hasOnly(['ownerId', 'title', 'titleLower', 'description', 'translation', 'language', 'cardCount', 'createdAt', 'updatedAt', 'hidden', 'v'])
        && validVersion(d)
        && d.keys().hasAll(['ownerId', 'title', 'titleLower', 'translation', 'language', 'cardCount', 'createdAt', 'updatedAt'])
        && isText(d.title, 1, 200)
        && d.titleLower == d.title.lower()
        && isTextOrNull(d.get('description', null), 2000)
        && translationOk(d)
        && d.cardCount is int && d.cardCount >= 0 && d.cardCount <= 1000;
    }
    function validCard(c) {
      return c.keys().hasOnly(['reference', 'verseText', 'position', 'v']) // a card's private note is never published
        && validVersion(c)
        && c.keys().hasAll(['reference', 'verseText', 'position'])
        && isText(c.reference, 1, 200)
        && isText(c.verseText, 1, 20000)
        && c.position is int && c.position >= 0 && c.position < 1000;
    }
    function ownsDeck(deckId) {
      return signedIn() && get(/databases/$(database)/documents/publicDecks/$(deckId)).data.ownerId == request.auth.uid;
    }

    // Anyone can report a public deck (for copyright, inappropriate content or anything else). Nobody can read reports
    // through the app: you read them in the Firebase console (filter status == open), then set status to "resolved"
    // and, if the deck must go, set hidden to true on the deck.
    match /reports/{reportId} {
      allow create: if request.resource.data.keys().hasOnly(['deckId', 'reason', 'details', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['deckId', 'reason', 'status', 'createdAt'])
        && request.resource.data.status == 'open'
        && isText(request.resource.data.deckId, 1, 100)
        && request.resource.data.reason in ['copyright', 'inappropriate', 'other']
        && isTextOrNull(request.resource.data.get('details', null), 500)
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // ---- A person's own backup: decks, cards, study schedules and a few settings, private to them. ----
    // One document per thing, named "deck~ID", "card~ID", "schedule~CARDID~KIND" or "setting~KEY". A newer version can
    // always replace an older one but never the other way round, so two devices that disagree end up with the latest edit.
    // A deleted thing is kept as a small "deleted" stub so other devices learn about it.
    function itemKind(itemId) { return itemId.split('~')[0]; }
    function nonNegInt(v) { return v is int && v >= 0; }
    function tombstone(d, itemId) {
      return d.keys().hasOnly(['entity', 'deleted', 'updatedAt', 'v', 'syncedAt'])
        && d.keys().hasAll(['entity', 'deleted', 'updatedAt', 'syncedAt'])
        && d.deleted == true
        && d.entity == itemKind(itemId)
        && itemKind(itemId) in ['deck', 'card', 'schedule']; // settings are never deleted
    }
    function liveDeck(d) {
      return d.keys().hasOnly(['entity', 'deleted', 'title', 'description', 'translation', 'language', 'publishId', 'importedFrom', 'createdAt', 'updatedAt', 'v', 'syncedAt'])
        && d.keys().hasAll(['entity', 'deleted', 'title', 'description', 'translation', 'language', 'publishId', 'importedFrom', 'createdAt', 'updatedAt', 'syncedAt'])
        && isText(d.title, 1, 200)
        && isTextOrNull(d.description, 2000)
        && isTextOrNull(d.translation, 40) && isTextOrNull(d.language, 40) && isTextOrNull(d.publishId, 100) && isTextOrNull(d.importedFrom, 100)
        && nonNegInt(d.createdAt);
    }
    function liveCard(d) {
      return d.keys().hasOnly(['entity', 'deleted', 'reference', 'verseText', 'note', 'createdAt', 'updatedAt', 'decks', 'v', 'syncedAt'])
        && d.keys().hasAll(['entity', 'deleted', 'reference', 'verseText', 'note', 'createdAt', 'updatedAt', 'decks', 'syncedAt'])
        && isText(d.reference, 1, 200)
        && isText(d.verseText, 1, 20000)
        && isTextOrNull(d.note, 2000)
        && nonNegInt(d.createdAt)
        && d.decks is list && d.decks.size() >= 1 && d.decks.size() <= 50;
    }
    function liveSchedule(d, itemId) {
      return d.keys().hasOnly(['entity', 'deleted', 'cardId', 'kind', 'due', 'stability', 'difficulty', 'state', 'reps', 'lapses', 'learningSteps', 'scheduledDays', 'lastReview', 'version', 'updatedAt', 'v', 'syncedAt'])
        && d.keys().hasAll(['entity', 'deleted', 'cardId', 'kind', 'due', 'stability', 'difficulty', 'state', 'reps', 'lapses', 'learningSteps', 'scheduledDays', 'lastReview', 'version', 'updatedAt', 'syncedAt'])
        && isText(d.cardId, 1, 100)
        && d.kind in ['recall', 'identify']
        && itemId == 'schedule~' + d.cardId + '~' + d.kind
        && d.due is number && d.stability is number && d.difficulty is number
        && d.state in [0, 1, 2, 3]
        && nonNegInt(d.reps) && nonNegInt(d.lapses) && nonNegInt(d.learningSteps) && nonNegInt(d.scheduledDays)
        && (d.lastReview == null || d.lastReview is number)
        && isText(d.version, 1, 100);
    }
    function liveSetting(d, itemId) {
      return d.keys().hasOnly(['entity', 'deleted', 'key', 'value', 'updatedAt', 'v', 'syncedAt'])
        && d.keys().hasAll(['entity', 'deleted', 'key', 'value', 'updatedAt', 'syncedAt'])
        && itemId == 'setting~' + d.key
        && d.key in ['new_cards_per_day', 'card_kinds', 'blank_difficulty']
        && ((d.value is string && d.value.size() <= 40) || d.value is number);
    }
    // `v` says which format the item was saved in. It is optional (items saved before versions existed have none: they count
    // as version 1), and an item may never be replaced by one in an OLDER format, so an app that has not been updated can
    // never overwrite what a newer app saved.
    function validVersion(d) { return !('v' in d) || (d.v is int && d.v >= 1 && d.v <= 1000); }
    function validItem(d, itemId) {
      return d.entity in ['deck', 'card', 'schedule', 'setting']
        && validVersion(d)
        && d.entity == itemKind(itemId)
        && d.updatedAt is int && d.updatedAt >= 0
        && d.syncedAt == request.time
        && d.deleted is bool
        && (d.deleted == true ? tombstone(d, itemId) : (
             (d.entity == 'deck' && liveDeck(d))
          || (d.entity == 'card' && liveCard(d))
          || (d.entity == 'schedule' && liveSchedule(d, itemId))
          || (d.entity == 'setting' && liveSetting(d, itemId))));
    }
    match /users/{uid}/items/{itemId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid && validItem(request.resource.data, itemId);
      allow update: if signedIn() && request.auth.uid == uid && validItem(request.resource.data, itemId)
        && request.resource.data.updatedAt >= resource.data.updatedAt
        && request.resource.data.get('v', 1) >= resource.data.get('v', 1);
      allow delete: if signedIn() && request.auth.uid == uid; // used when the person deletes their account
    }

    match /publicDecks/{deckId} {
      allow get, list: if true;

      allow create: if signedIn()
        && validDeck(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && !('hidden' in request.resource.data) // only you (in the console) can hide a deck
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && validDeck(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.get('hidden', false) == resource.data.get('hidden', false) // the author cannot un-hide a deck
        && request.resource.data.get('v', 1) >= resource.data.get('v', 1) // never an older format over a newer one
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      // Cards must be deleted before their deck (afterwards nobody could prove who owned them).
      match /cards/{cardId} {
        allow get, list: if true;
        allow create: if ownsDeck(deckId) && validCard(request.resource.data);
        allow update: if ownsDeck(deckId) && validCard(request.resource.data)
          && request.resource.data.get('v', 1) >= resource.data.get('v', 1); // never an older format over a newer one
        allow delete: if ownsDeck(deckId);
      }
    }
  }
}
