{
  "firestore": {
    "database": "(default)",
    "location": "nam7",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "firestore": {
      "port": 8181
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": false
  },
  "hosting": {
    "public": "dist-web",
    "predeploy": ["npm run build:web"],
    "redirects": [
      { "source": "/landing", "destination": "/", "type": 301 },
      { "source": "/es/landing", "destination": "/es", "type": 301 }
    ],
    "rewrites": [
      { "source": "/d/**", "destination": "/deck-link.html" }
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/(privacy-policy|terms|delete-account)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ]
  }
}
