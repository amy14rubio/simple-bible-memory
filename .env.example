# Copy this file to .env.local (which git ignores) and fill in your key.
# Optional: without a key the Font page offers a short hand-picked list instead of the full Google Fonts catalogue.
#
# Get a key: Google Cloud Console > create a project > APIs & Services > enable "Web Fonts Developer API" >
# Credentials > Create credentials > API key. Then edit the key and restrict it:
#   - API restrictions: only "Web Fonts Developer API"
#   - Application restrictions: HTTP referrers (your site's address, and http://localhost:* for development)
# The key is bundled into the app, so these restrictions are what protect it.
VITE_GOOGLE_FONTS_API_KEY=

# Firebase (project simple-bible-memory), used for sharing decks. Find these in the Firebase console:
# Project settings > Your apps > Simple Bible Memory (web), or run: firebase apps:sdkconfig WEB <app id> --project simple-bible-memory
# They identify the project and are not secrets; security comes from Firestore rules and Authentication, not from hiding them.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Bible text autofill (the card form's "Autofill") comes from the YouVersion Platform: https://developers.youversion.com
# Request your own app key there and put it here. Never commit it and never reuse someone else's: the platform counts requests per key.
# Without a key everything else works; people just type or paste their own verses.
# The key is bundled into the app (it cannot be hidden in a client app), so set the restrictions the platform offers.
VITE_YOUVERSION_APP_KEY=

# Sharing and Discover without a Firebase project: set this to "fake" to use an in-memory stand-in (nothing is saved or sent).
# Leave it empty to use the real Firebase values above.
VITE_SHARING_BACKEND=
