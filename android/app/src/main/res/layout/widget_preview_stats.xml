<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows for "Statistics": just the big number and its label (the widget itself adds the chart). Follows the phone's light or dark setting. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card"
        android:tint="@color/widget_preview_border" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="1dp"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card"
        android:tint="@color/widget_preview_surface" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="24"
            android:textColor="@color/widget_preview_foreground"
            android:autoSizeMaxTextSize="60sp"
                android:autoSizeMinTextSize="26sp"
                android:autoSizeStepGranularity="2sp"
                android:autoSizeTextType="uniform"
                android:textSize="60sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:text="@string/widget_memorized"
            android:textColor="@color/widget_preview_muted"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
