<?xml version="1.0" encoding="utf-8"?>
<!-- The "Add card" widget: a rounded pill (surface colour), a rose badge with a plus, and the words. Colours are set by AddCardWidget from the app's theme. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <ImageView
        android:id="@+id/widget_ring"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_pill" />

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="1dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_pill" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="18dp">

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp">

            <ImageView
                android:id="@+id/widget_badge"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_circle" />

            <ImageView
                android:id="@+id/widget_plus"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:padding="9dp"
                android:src="@drawable/ic_widget_plus" />
        </FrameLayout>

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:maxLines="1"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
